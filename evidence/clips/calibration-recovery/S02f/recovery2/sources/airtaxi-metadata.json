ntID": "xmp.did:edb3aa86-df98-4b0a-94a0-966a0d185433", "XMP:ProjectRef": {"Type": "Movie"}, "XMP:Source": "Digital Motion Image", "XMP:StartTimeSampleSize": 1001, "XMP:StartTimeScale": 30000, "XMP:StartTimecode": {"TimeFormat": "29.97 fps (drop)", "TimeValue": "00;00;00;00"}, "XMP:Subject": ["AAM or Advanced Air RVLT GANTRY Test drop Mobility"], "XMP:Title": "RVLT Gantry Drop Test", "XMP:TransmissionReference": "V0002050", "XMP:UsageTerms": "Released to the Public", "XMP:VideoFieldOrder": "Progressive", "XMP:VideoFrameRate": 29.97003, "XMP:VideoFrameSize": {"H": 2160, "Unit": "pixel", "W": 3840}, "XMP:VideoPixelAspectRatio": 1, "XMP:WindowsAtom": {"Extension": ".prproj", "InvocationFlags": "/L"}, "XMP:XMPToolkit": "Adobe XMP Core 9.1-c002 165.59ab891, 2024/09/18-09:57:10        ", "Composite:AvgBitrate": "3.22 Mbps", "Composite:ImageSize": "3840x2160", "Composite:Megapixels": 8.3, "Composite:Rotation": 0, "AVAIL:MediaType": "video", "AVAIL:NASAID": "LRC-2025-V-06242025-RVLT-Gantry-Drop-Test-With-Slate-V0002050", "AVAIL:Owner": "bmherre1", "AVAIL:Center": "LaRC", "AVAIL:Album": [], "AVAIL:DateCreated": "2025-06-24T00:00:00Z", "AVAIL:Description": "Researchers at NASA’s Langley Research Center in Hampton, Virginia, dropped a full-scale aircraft body, modeled after an air taxi, from a tall steel structure, known as a gantry, at the center’s Landing and Impact Research Facility. \nThis and a previous test in late 2022 allow researchers to investigate aircraft materials that best absorb impact forces in a crash to protect the passengers and cargo inside. The data collected will enable manufacturers to design safer advanced air mobility aircraft.\n", "AVAIL:Description508": "", "AVAIL:Keywords": ["AAM or Advanced Air RVLT GANTRY Test drop Mobility"], "AVAIL:Location": "NASA Langley Research Center", "AVAIL:Photographer": "NASA LaRC_OCIO_Video Services_Bono_Herrera", "AVAIL:SecondaryCreator": "", "AVAIL:Title": "NASA Drop Test Supports Safer Air Taxi Designs "}