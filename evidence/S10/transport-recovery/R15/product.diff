+  const children = controlledBridge(t);
+  for (const text of ['µ', '€', '😀']) {
+    const reply = { ...startReply, limitations: [text] }, bytes = Buffer.from(JSON.stringify(reply));
+    const offset = bytes.indexOf(Buffer.from(text));
